---
apiVersion: v1
kind: ConfigMap
metadata:
  name: workflow-proxy-config
  namespace: {{ app_namespace }}
  labels:
    app: workflow-proxy
    component: proxy
data:
  nginx.conf: |
    pid /tmp/nginx.pid;

    events {
        worker_connections 1024;
    }

    http {
        client_body_temp_path /tmp/client_temp;
        proxy_temp_path       /tmp/proxy_temp;
        fastcgi_temp_path     /tmp/fastcgi_temp;
        uwsgi_temp_path       /tmp/uwsgi_temp;
        scgi_temp_path        /tmp/scgi_temp;
        log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                        '$status $body_bytes_sent "$http_referer" '
                        '"$http_user_agent" "$http_x_forwarded_for" '
                        'workflow_type="$http_x_workflow_type"';

        access_log /var/log/nginx/access.log main;
        error_log /var/log/nginx/error.log warn;

        upstream rhdp_published {
            server rhdp-published.{{ app_namespace }}.svc.cluster.local:80;
        }

        # Map X-Workflow-Type header to upstream
        map $http_x_workflow_type $workflow_upstream {
            default rhdp_published;
            "rhdp-published" rhdp_published;
            "rhdp_published" rhdp_published;
        }

        server {
            listen 8080;
            server_name _;

            location / {
                proxy_pass http://$workflow_upstream;
                proxy_set_header Host $host;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
                proxy_set_header X-Workflow-Type $http_x_workflow_type;

                # Timeouts for long-running workflow operations
                proxy_connect_timeout 60s;
                proxy_send_timeout 300s;
                proxy_read_timeout 300s;
            }

            location /health {
                access_log off;
                return 200 "healthy\n";
                add_header Content-Type text/plain;
            }
        }
    }
