openapi: 3.0.0
info:
  title: Publishing House Central API
  version: 1.0.0
  description: OpenAPI spec consumed by SonataFlow for workflow REST calls
servers:
  - url: https://central-api-{{ app_namespace }}.{{ ocp_apps_domain }}/api/v1
paths:
  /jira/epic:
    post:
      operationId: createJiraEpic
      summary: Create a Jira epic with rich description and optional ProForma form
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - epic_type
                - fields
              properties:
                epic_type:
                  type: string
                  enum: [rhdp_published, field_source]
                  description: Type of epic to create
                fields:
                  type: object
                  description: All template fields as key-value pairs
      responses:
        '200':
          description: Epic created successfully
          content:
            application/json:
              schema:
                type: object
                properties:
                  epic_key:
                    type: string
                  jira_url:
                    type: string
                  proforma_form_id:
                    type: string
      security:
        - bearerAuth: []
  /jira/epic/update:
    post:
      operationId: updateJiraEpic
      summary: Update Jira epic description after pre-intake approval
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - epic_key
                - epic_type
              properties:
                epic_key:
                  type: string
                epic_type:
                  type: string
                  enum: [rhdp_published, field_source]
                proforma_form_id:
                  type: string
                fields:
                  type: object
                  description: Fallback field values if ProForma not used
      responses:
        '200':
          description: Epic updated successfully
          content:
            application/json:
              schema:
                type: object
                properties:
                  epic_key:
                    type: string
                  updated:
                    type: boolean
      security:
        - bearerAuth: []
  /projects/create-repo:
    post:
      operationId: createRepo
      summary: Create GitHub repository from template and add collaborators
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - project_id
                - repo_owner
                - template_repo
              properties:
                project_id:
                  type: string
                repo_owner:
                  type: string
                template_repo:
                  type: string
                collaborators:
                  type: array
                  items:
                    type: object
                    properties:
                      user:
                        type: string
                      access:
                        type: string
      responses:
        '200':
          description: Repository created successfully
          content:
            application/json:
              schema:
                type: object
                properties:
                  repo_url:
                    type: string
                  commit_hash:
                    type: string
      security:
        - bearerAuth: []
  /jira/sync:
    post:
      operationId: syncJiraTasks
      summary: Sync Jira tasks from project repo
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - repo_url
                - epic_key
              properties:
                repo_url:
                  type: string
                epic_key:
                  type: string
                slug:
                  type: string
                status:
                  type: string
      responses:
        '200':
          description: Jira sync completed
          content:
            application/json:
              schema:
                type: object
                properties:
                  epic_key:
                    type: string
                  tasks_created:
                    type: integer
                  intake_closed:
                    type: boolean
      security:
        - bearerAuth: []
components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
