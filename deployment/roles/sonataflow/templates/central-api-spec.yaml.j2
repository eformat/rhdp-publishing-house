openapi: 3.0.0
info:
  title: Publishing House Central API
  version: 1.0.0
  description: OpenAPI spec consumed by SonataFlow for workflow REST calls
servers:
  - url: http://central-api.{{ app_namespace }}:8000/api/v1
paths:
  /jira/epic:
    post:
      operationId: createJiraEpic
      summary: Create a Jira epic with rich description and optional ProForma form
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - businessKey
                - deploymentMode
              properties:
                businessKey:
                  type: string
                  description: Project ID used as workflow business key
                deploymentMode:
                  type: string
                  description: Workflow type (rhdp-published, field-source, etc.)
      responses:
        '200':
          description: Epic created successfully
          content:
            application/json:
              schema:
                type: object
                properties:
                  epic_key:
                    type: string
                  jira_url:
                    type: string
                  proforma_form_id:
                    type: string
      security:
        - bearerAuth: []
  /jira/epic/{epic_key}/create-initial-tasks:
    post:
      operationId: createInitialTasks
      summary: Create Intake and Development CI tasks after pre-intake approval
      parameters:
        - name: epic_key
          in: path
          required: true
          schema:
            type: string
          description: Jira epic key (e.g., RHDPCD-123)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                showroomType:
                  type: string
                  description: Showroom type (classic or zero_touch)
                  default: classic
      responses:
        '200':
          description: Initial tasks created successfully
          content:
            application/json:
              schema:
                type: object
                properties:
                  status:
                    type: string
                  epic_key:
                    type: string
      security:
        - bearerAuth: []
  /jira/epic/update:
    post:
      operationId: updateJiraEpic
      summary: Update Jira epic description after pre-intake approval
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - epic_key
                - businessKey
                - deploymentMode
              properties:
                epic_key:
                  type: string
                businessKey:
                  type: string
                  description: Project ID used as workflow business key
                deploymentMode:
                  type: string
                  description: Workflow type (rhdp-published, field-source, etc.)
      responses:
        '200':
          description: Epic updated successfully
          content:
            application/json:
              schema:
                type: object
                properties:
                  epic_key:
                    type: string
                  updated:
                    type: boolean
      security:
        - bearerAuth: []
  /projects/{project_id}/create-catalog:
    post:
      operationId: createCatalog
      summary: Create GitHub repository from template, sync workflow metadata, and register Backstage catalog
      parameters:
        - name: project_id
          in: path
          required: true
          schema:
            type: string
          description: Project ID (businessKey)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - deploymentMode
              properties:
                deploymentMode:
                  type: string
                  description: Workflow type (rhdp-published, field-source, etc.)
                repo_owner:
                  type: string
                  default: "rhpds"
                collaborators:
                  type: array
                  items:
                    type: object
                    properties:
                      user:
                        type: string
                      access:
                        type: string
      responses:
        '200':
          description: Repository and catalog created successfully
          content:
            application/json:
              schema:
                type: object
                properties:
                  repo_url:
                    type: string
                  commit_hash:
                    type: string
                  catalog_registered:
                    type: boolean
      security:
        - bearerAuth: []
  /jira/sync:
    post:
      operationId: syncJiraTasks
      summary: Sync Jira tasks from project repo
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - businessKey
                - deploymentMode
              properties:
                businessKey:
                  type: string
                  description: Project ID used as workflow business key
                deploymentMode:
                  type: string
                  description: Workflow type (rhdp-published, field-source, etc.)
                status:
                  type: string
                  description: Stage completion status (IntakeComplete, EnvSetupComplete, etc.)
      responses:
        '200':
          description: Jira sync completed
          content:
            application/json:
              schema:
                type: object
                properties:
                  epic_key:
                    type: string
                  tasks_created:
                    type: integer
                  intake_closed:
                    type: boolean
      security:
        - bearerAuth: []
  /jira/epic/{epic_key}/preintake-data:
    get:
      operationId: getPreIntakeData
      summary: Get pre-intake data from ProForma form
      parameters:
        - name: epic_key
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: Pre-intake data retrieved successfully
          content:
            application/json:
              schema:
                type: object
                properties:
                  assetTitle:
                    type: string
                  projectDescription:
                    type: string
                  contentOutline:
                    type: string
                  learningObjectives:
                    type: string
                  contentType:
                    type: string
                  audience:
                    type: string
                  duration:
                    type: string
                  prerequisites:
                    type: string
                  author:
                    type: string
                  associatedOpportunities:
                    type: string
                  salesPlayTdp:
                    type: string
                  technicalNotes:
                    type: string
      security:
        - bearerAuth: []
components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
