openapi: 3.0.0
info:
  title: Publishing House Central API
  version: 1.0.0
  description: OpenAPI spec consumed by SonataFlow for workflow REST calls
servers:
  - url: https://central-api-{{ app_namespace }}.{{ ocp_apps_domain }}/api/v1
paths:
  /jira/epic:
    post:
      operationId: createJiraEpic
      summary: Create a Jira epic with rich description and optional ProForma form
      parameters:
        - name: X-Workflow-Type
          in: header
          required: true
          schema:
            type: string
            enum: [rhdp-published, rhdp_published, field-source, field_source]
          description: Workflow type (required header)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - fields
              properties:
                fields:
                  type: object
                  description: All template fields as key-value pairs
      responses:
        '200':
          description: Epic created successfully
          content:
            application/json:
              schema:
                type: object
                properties:
                  epic_key:
                    type: string
                  jira_url:
                    type: string
                  proforma_form_id:
                    type: string
      security:
        - bearerAuth: []
  /jira/epic/update:
    post:
      operationId: updateJiraEpic
      summary: Update Jira epic description after pre-intake approval
      parameters:
        - name: X-Workflow-Type
          in: header
          required: true
          schema:
            type: string
            enum: [rhdp-published, rhdp_published, field-source, field_source]
          description: Workflow type (required header)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - epic_key
              properties:
                epic_key:
                  type: string
                proforma_form_id:
                  type: string
                fields:
                  type: object
                  description: Fallback field values if ProForma not used
      responses:
        '200':
          description: Epic updated successfully
          content:
            application/json:
              schema:
                type: object
                properties:
                  epic_key:
                    type: string
                  updated:
                    type: boolean
      security:
        - bearerAuth: []
  /projects/{project_id}/create-catalog:
    post:
      operationId: createCatalog
      summary: Create GitHub repository from template, sync workflow metadata, and register Backstage catalog
      parameters:
        - name: project_id
          in: path
          required: true
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                repo_owner:
                  type: string
                  default: "rhpds"
                collaborators:
                  type: array
                  items:
                    type: object
                    properties:
                      user:
                        type: string
                      access:
                        type: string
      responses:
        '200':
          description: Repository and catalog created successfully
          content:
            application/json:
              schema:
                type: object
                properties:
                  repo_url:
                    type: string
                  commit_hash:
                    type: string
                  catalog_registered:
                    type: boolean
      security:
        - bearerAuth: []
  /jira/sync:
    post:
      operationId: syncJiraTasks
      summary: Sync Jira tasks from project repo
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - repo_url
                - epic_key
              properties:
                repo_url:
                  type: string
                epic_key:
                  type: string
                slug:
                  type: string
                status:
                  type: string
      responses:
        '200':
          description: Jira sync completed
          content:
            application/json:
              schema:
                type: object
                properties:
                  epic_key:
                    type: string
                  tasks_created:
                    type: integer
                  intake_closed:
                    type: boolean
      security:
        - bearerAuth: []
  /jira/epic/{epic_key}/preintake-data:
    get:
      operationId: getPreIntakeData
      summary: Get pre-intake data from ProForma form
      parameters:
        - name: epic_key
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: Pre-intake data retrieved successfully
          content:
            application/json:
              schema:
                type: object
                properties:
                  assetTitle:
                    type: string
                  projectDescription:
                    type: string
                  contentOutline:
                    type: string
                  learningObjectives:
                    type: string
                  contentType:
                    type: string
                  audience:
                    type: string
                  duration:
                    type: string
                  prerequisites:
                    type: string
                  author:
                    type: string
                  associatedOpportunities:
                    type: string
                  salesPlayTdp:
                    type: string
                  technicalNotes:
                    type: string
      security:
        - bearerAuth: []
components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
