---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: workflow-proxy
  namespace: {{ app_namespace }}
  labels:
    app: workflow-proxy
    component: proxy
spec:
  replicas: 1
  selector:
    matchLabels:
      app: workflow-proxy
  template:
    metadata:
      labels:
        app: workflow-proxy
        component: proxy
    spec:
      containers:
      - name: nginx
        image: docker.io/nginx:1.27-alpine
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 8080
          name: http
          protocol: TCP
        resources:
          limits:
            cpu: 500m
            memory: 512Mi
          requests:
            cpu: 100m
            memory: 128Mi
        volumeMounts:
        - name: nginx-config
          mountPath: /etc/nginx/nginx.conf
          subPath: nginx.conf
        livenessProbe:
          httpGet:
            path: /health
            port: 8080
          initialDelaySeconds: 10
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /health
            port: 8080
          initialDelaySeconds: 5
          periodSeconds: 5
      volumes:
      - name: nginx-config
        configMap:
          name: workflow-proxy-config
