apiVersion: sonataflow.org/v1alpha08
kind: SonataFlow
metadata:
  annotations:
    sonataflow.org/description: RHDP Published content lifecycle with pre-intake review
    sonataflow.org/profile: preview
    sonataflow.org/version: "2.0"
  labels:
    app: publishing-house
    component: workflow
    sonataflow.org/workflow-app: rhdp-published
  name: rhdp-published
  namespace: "{{ app_namespace }}"
spec:
  properties:
    mp.messaging.outgoing.kogito-processinstances-events.url: http://sonataflow-platform-data-index-service.{{ app_namespace }}.svc.cluster.local/events
  flow:
    dataInputSchema:
      failOnValidationErrors: false
      schema: input-schema.json
    events:
      - correlation:
          - contextAttributeName: projectid
        dataOnly: true
        kind: consumed
        name: IntakeCompleteEvent
        source: publishing-house
        type: ph.intake.complete
      - correlation:
          - contextAttributeName: projectid
        dataOnly: true
        kind: consumed
        name: ContentReviewCompleteEvent
        source: publishing-house
        type: ph.content-review.complete
      - correlation:
          - contextAttributeName: projectid
        dataOnly: true
        kind: consumed
        name: InfraReviewCompleteEvent
        source: publishing-house
        type: ph.infra-review.complete
      - correlation:
          - contextAttributeName: projectid
        dataOnly: true
        kind: consumed
        name: ContentReviewRejectedEvent
        source: publishing-house
        type: ph.content-review.rejected
      - correlation:
          - contextAttributeName: projectid
        dataOnly: true
        kind: consumed
        name: InfraReviewRejectedEvent
        source: publishing-house
        type: ph.infra-review.rejected
      - correlation:
          - contextAttributeName: projectid
        dataOnly: true
        kind: consumed
        name: EnvSetupCompleteEvent
        source: publishing-house
        type: ph.env-setup.complete
      - correlation:
          - contextAttributeName: projectid
        dataOnly: true
        kind: consumed
        name: DevelopmentCompleteEvent
        source: publishing-house
        type: ph.development.complete
      - correlation:
          - contextAttributeName: projectid
        dataOnly: true
        kind: consumed
        name: TestingCompleteEvent
        source: publishing-house
        type: ph.testing.complete
      - correlation:
          - contextAttributeName: projectid
        dataOnly: true
        kind: consumed
        name: PreIntakeReviewApprovedEvent
        source: publishing-house
        type: ph.preintake-review.approved
      - correlation:
          - contextAttributeName: projectid
        dataOnly: true
        kind: consumed
        name: PreIntakeReviewRejectedEvent
        source: publishing-house
        type: ph.preintake-review.rejected
      - correlation:
          - contextAttributeName: projectid
        dataOnly: true
        kind: consumed
        name: PreIntakeReviewCancelledEvent
        source: publishing-house
        type: ph.preintake-review.cancelled
      - correlation:
          - contextAttributeName: projectid
        dataOnly: true
        kind: consumed
        name: PreIntakeSubmittedEvent
        source: publishing-house
        type: ph.preintake.submitted
      - correlation:
          - contextAttributeName: projectid
        dataOnly: true
        kind: consumed
        name: CatalogCreatedEvent
        source: publishing-house
        type: ph.catalog.created
    functions:
      - name: printMessage
        operation: sysout
        type: custom
      - name: createjiraepic
        operation: specs/central-api.yaml#createJiraEpic
        type: rest
      - name: syncjiratasks
        operation: specs/central-api.yaml#syncJiraTasks
        type: rest
      - name: updatejiraepic
        operation: specs/central-api.yaml#updateJiraEpic
        type: rest
      - name: createinitialtasks
        operation: specs/central-api.yaml#createInitialTasks
        type: rest
      - name: createcatalog
        operation: specs/central-api.yaml#createCatalog
        type: rest
    start:
      stateName: Init
    states:
      - name: Init
        type: inject
        data: {}
        transition:
          nextState: Setup
      - name: Setup
        type: inject
        data: {}
        stateDataFilter:
          output: |
            . + {
              createdAt: now(),
              deploymentMode: .deploymentMode,
              ssoUser: .ssoUser,
              ssoEmail: .ssoEmail,
              projectid: .projectId,
              contentType: .contentType,
              repoUrl: (.repoUrl // ""),
              tags: (.tags // []),
              projectDescription: (.projectDescription // ""),
              showroomType: (.showroomType // "classic"),
              intakeType: (.intakeType // "new"),
              assetTitle: (.assetTitle // ""),
              contentOutline: (.contentOutline // ""),
              learningObjectives: (.learningObjectives // ""),
              associatedOpportunities: (.associatedOpportunities // ""),
              salesPlayTdp: (.salesPlayTdp // ""),
              aiRelated: (.aiRelated // false),
              canUseMaas: (.canUseMaas // true),
              maasModels: (.maasModels // ""),
              gpuJustification: (.gpuJustification // ""),
              partnersAccess: (.partnersAccess // false),
              cloudProvider: (.cloudProvider // "cnv"),
              clusterType: (.clusterType // "sno"),
              ocpVersion: (.ocpVersion // "4.21"),
              automationType: (.automationType // "ansible"),
              initiativeKey: (.initiativeKey // "rh1_2027"),
              teamMembers: (.teamMembers // []),
              reviews: {
                content: false,
                infra: false
              },
              rejection: {
                isRejected: false
              },
              reviewHistory: [],
              notes: [],
              baselineSha: "",
              auditTrailSha: (.auditTrailSha // ""),
              hasDrift: false,
              epic_key: "",
              jira_url: ""
            }
        transition:
          nextState: CreateEpic
      - name: CreateEpic
        type: operation
        actions:
          - name: CreateJiraEpic
            functionRef:
              refName: createjiraepic
              arguments:
                businessKey: .projectId
                deploymentMode: .deploymentMode
            actionDataFilter:
              toStateData: .epicResponse
        stateDataFilter:
          output: |
            . + {
              epic_key: (
                if .epicResponse
                then .epicResponse.epic_key
                else ""
                end
              ),
              jira_url: (
                if .epicResponse
                then .epicResponse.jira_url
                else ""
                end
              )
            } | del(.epicResponse)
        transition:
          nextState: PreIntakeReview
      - name: PreIntake
        type: event
        exclusive: true
        onEvents:
          - eventRefs:
              - PreIntakeSubmittedEvent
            eventDataFilter:
              toStateData: ".updatedFields"
        stateDataFilter:
          input: |
            . + {
              updatedFields: null,
              reviewHistory: ((.reviewHistory // []) + [{
                stage: "pre_intake",
                action: "submitted",
                timestamp: (now | tostring),
                user: .ssoEmail
              }])
            }
          output: |
            . + (.updatedFields // {}) + {
              reviewHistory: ((.reviewHistory // []) + [{
                stage: "pre_intake",
                action: "completed",
                timestamp: (now | tostring),
                user: .ssoEmail
              }])
            } | del(.updatedFields)
        transition:
          nextState: PreIntakeReview
      - name: PreIntakeReview
        type: event
        exclusive: true
        onEvents:
          - eventRefs:
              - PreIntakeReviewApprovedEvent
            eventDataFilter:
              toStateData: ".reviewAction"
          - eventRefs:
              - PreIntakeReviewRejectedEvent
            eventDataFilter:
              toStateData: ".reviewAction"
          - eventRefs:
              - PreIntakeReviewCancelledEvent
            eventDataFilter:
              toStateData: ".reviewAction"
        timeouts:
          stateExecTimeout: PT168H
        stateDataFilter:
          input: |
            . + {
              reviewAction: null,
              reviewHistory: ((.reviewHistory // []) + [{
                stage: "pre_intake_review",
                action: "started",
                timestamp: (now | tostring),
                user: "system"
              }])
            }
          output: |
            . + {
              reviewHistory: ((.reviewHistory // []) + (if .reviewAction then [.reviewAction] else [] end)),
              rejection: (
                if .reviewAction and .reviewAction.action == "rejected"
                then {
                  isRejected: true,
                  reviewerName: .reviewAction.user,
                  reviewerStage: "preintake",
                  timestamp: .reviewAction.timestamp,
                  reasons: (.reviewAction.reasons // [])
                }
                else { isRejected: false }
                end
              )
            } | del(.reviewAction)
        transition:
          nextState: PreIntakeReviewDecision
      - name: PreIntakeReviewDecision
        type: switch
        dataConditions:
          - name: Cancelled
            condition: |
              ${
                (.reviewHistory // [])[-1].action == "cancelled"
              }
            transition:
              nextState: Rejected
          - name: Rejected
            condition: "${ .rejection.isRejected == true }"
            transition:
              nextState: PreIntake
        defaultCondition:
          transition:
            nextState: UpdateEpic
      - name: UpdateEpic
        type: operation
        actions:
          - name: UpdateJiraEpic
            condition: "${ .epic_key != \"\" }"
            functionRef:
              refName: updatejiraepic
              arguments:
                epic_key: .epic_key
                businessKey: .projectId
                deploymentMode: .deploymentMode
        transition:
          nextState: CreateCatalog
      - name: CreateCatalog
        type: operation
        actions:
          - name: CreateGitHubRepoAndCatalog
            functionRef:
              refName: createcatalog
              arguments:
                project_id: .projectId
                deploymentMode: .deploymentMode
                repo_owner: "rhpds"
                collaborators: (.teamMembers // [])
        transition:
          nextState: WaitForCatalog
      - name: WaitForCatalog
        type: event
        exclusive: true
        onEvents:
          - eventRefs:
              - CatalogCreatedEvent
            eventDataFilter:
              toStateData: ".catalogData"
        timeouts:
          stateExecTimeout: PT60S
        stateDataFilter:
          output: |
            . + {
              repoUrl: (.catalogData.repoUrl // ""),
              commitHash: (.catalogData.commitHash // ""),
              catalogRegistered: (.catalogData.catalogRegistered // false),
              auditTrailSha: (.catalogData.commitSha // "")
            } | del(.catalogData)
        transition:
          nextState: CreateInitialTasks
      - name: CreateInitialTasks
        type: operation
        actions:
          - name: CreateJiraInitialTasks
            condition: "${ .epic_key != \"\" }"
            functionRef:
              refName: createinitialtasks
              arguments:
                epic_key: .epic_key
                showroomType: .showroomType
        transition:
          nextState: Intake
      - name: Rejected
        type: inject
        data:
          stage: rejected
        end:
          terminate: true
      - name: Intake
        type: event
        exclusive: true
        onEvents:
          - eventRefs:
              - IntakeCompleteEvent
            actions:
              - name: LogIntakeComplete
                functionRef:
                  refName: printMessage
                  arguments:
                    message: "Intake completed, starting reviews"
            eventDataFilter:
              toStateData: ".latestAudit"
        stateDataFilter:
          input: |
            . + {
              latestAudit: null,
              reviewHistory: ((.reviewHistory // []) + [{stage: "intake", action: "started", timestamp: (now | tostring), user: "system", commitSha: (.auditTrailSha // "")}])
            }
          output: |
            . + {
              reviewHistory: ((.reviewHistory // []) + (if .latestAudit then [.latestAudit] else [] end)),
              auditTrailSha: (.latestAudit.commitSha // .auditTrailSha),
              baselineSha: (.latestAudit.commitSha // ""),
              rejection: (.rejection + { isRejected: false, reasons: [(.rejection.reasons // [])[] | . + {resolved: true}] }),
              hasDrift: false
            }
        transition:
          nextState: ContentReview
      - name: ContentReview
        type: event
        exclusive: true
        onEvents:
          - eventRefs:
              - ContentReviewCompleteEvent
            actions:
              - name: LogContentReviewApproved
                functionRef:
                  refName: printMessage
                  arguments:
                    message: "Content review approved"
            eventDataFilter:
              toStateData: ".latestAudit"
          - eventRefs:
              - ContentReviewRejectedEvent
            actions:
              - name: LogContentReviewRejected
                functionRef:
                  refName: printMessage
                  arguments:
                    message: "Content review rejected — returning to intake"
            eventDataFilter:
              toStateData: ".latestAudit"
        stateDataFilter:
          input: |
            . + {
              latestAudit: null,
              reviewHistory: ((.reviewHistory // []) + [{stage: "content_review", action: "started", timestamp: (now | tostring), user: "system", commitSha: (.auditTrailSha // "")}])
            }
          output: |
            . + {
              reviewHistory: ((.reviewHistory // []) + (if .latestAudit then [.latestAudit] else [] end)),
              auditTrailSha: (.latestAudit.commitSha // .auditTrailSha),
              baselineSha: (if .latestAudit then (if .latestAudit.action == "approved" then .latestAudit.commitSha else .baselineSha end) else .baselineSha end),
              rejection: (if .latestAudit then (if .latestAudit.action == "rejected" then { isRejected: true, reviewerName: .latestAudit.user, reviewerStage: .latestAudit.stage, timestamp: .latestAudit.timestamp, reasons: ((.rejection.reasons // []) + .latestAudit.reasons) } else (.rejection + { isRejected: false, reasons: [(.rejection.reasons // [])[] | . + {resolved: true}] }) end) else { isRejected: false } end)
            }
        transition:
          nextState: ContentReviewDecision
      - name: ContentReviewDecision
        type: switch
        dataConditions:
          - condition: "${ .rejection.isRejected == true }"
            transition:
              nextState: Intake
        defaultCondition:
          transition:
            nextState: InfraReview
      - name: InfraReview
        type: event
        exclusive: true
        onEvents:
          - eventRefs:
              - InfraReviewCompleteEvent
            actions:
              - name: LogInfraReviewApproved
                functionRef:
                  refName: printMessage
                  arguments:
                    message: "Infra review approved"
            eventDataFilter:
              toStateData: ".latestAudit"
          - eventRefs:
              - InfraReviewRejectedEvent
            actions:
              - name: LogInfraReviewRejected
                functionRef:
                  refName: printMessage
                  arguments:
                    message: "Infra review rejected — returning to intake"
            eventDataFilter:
              toStateData: ".latestAudit"
        stateDataFilter:
          input: |
            . + {
              latestAudit: null,
              reviewHistory: ((.reviewHistory // []) + [{stage: "infra_review", action: "started", timestamp: (now | tostring), user: "system", commitSha: (.auditTrailSha // "")}])
            }
          output: |
            . + {
              reviewHistory: ((.reviewHistory // []) + (if .latestAudit then [.latestAudit] else [] end)),
              auditTrailSha: (.latestAudit.commitSha // .auditTrailSha),
              baselineSha: (if .latestAudit then (if .latestAudit.action == "approved" then .latestAudit.commitSha else .baselineSha end) else .baselineSha end),
              rejection: (if .latestAudit then (if .latestAudit.action == "rejected" then { isRejected: true, reviewerName: .latestAudit.user, reviewerStage: .latestAudit.stage, timestamp: .latestAudit.timestamp, reasons: ((.rejection.reasons // []) + .latestAudit.reasons) } else (.rejection + { isRejected: false, reasons: [(.rejection.reasons // [])[] | . + {resolved: true}] }) end) else { isRejected: false } end)
            }
        transition:
          nextState: InfraReviewDecision
      - name: InfraReviewDecision
        type: switch
        dataConditions:
          - condition: "${ .rejection.isRejected == true }"
            transition:
              nextState: Intake
          - condition: "${ .showroomType == \"zero_touch\" }"
            transition:
              nextState: JiraSyncIntake
        defaultCondition:
          transition:
            nextState: JiraSyncIntake
      - name: JiraSyncIntake
        type: operation
        actions:
          - name: SyncJiraIntake
            functionRef:
              refName: syncjiratasks
              arguments:
                businessKey: .projectId
                deploymentMode: .deploymentMode
                status: "IntakeComplete"
            actionDataFilter:
              toStateData: .jiraSyncResponse
        stateDataFilter:
          output: ". | del(.jiraSyncResponse)"
        transition:
          nextState: EnvSetupOrDev
      - name: EnvSetupOrDev
        type: switch
        dataConditions:
          - condition: "${ .showroomType == \"zero_touch\" }"
            transition:
              nextState: Development
        defaultCondition:
          transition:
            nextState: EnvSetup
      - name: EnvSetup
        type: event
        exclusive: true
        onEvents:
          - eventRefs:
              - EnvSetupCompleteEvent
            actions:
              - name: LogEnvSetupComplete
                functionRef:
                  refName: printMessage
                  arguments:
                    message: "Env setup completed, transitioning to Development"
            eventDataFilter:
              toStateData: ".latestAudit"
        stateDataFilter:
          input: |
            . + {
              latestAudit: null,
              reviewHistory: ((.reviewHistory // []) + [{stage: "env_setup", action: "started", timestamp: (now | tostring), user: "system", commitSha: (.auditTrailSha // "")}])
            }
          output: |
            . + {
              reviewHistory: ((.reviewHistory // []) + (if .latestAudit then [.latestAudit] else [] end)),
              agnosticvUrls: (.latestAudit.agnosticvUrls // .agnosticvUrls // []),
              ciUrls: (.latestAudit.ciUrls // .ciUrls // [])
            }
        transition:
          nextState: JiraSyncEnvSetup
      - name: JiraSyncEnvSetup
        type: operation
        actions:
          - name: SyncJiraEnvSetup
            functionRef:
              refName: syncjiratasks
              arguments:
                businessKey: .projectId
                deploymentMode: .deploymentMode
                status: "EnvSetupComplete"
            actionDataFilter:
              toStateData: .jiraSyncResponse
        stateDataFilter:
          output: ". | del(.jiraSyncResponse)"
        transition:
          nextState: Development
      - name: Development
        type: event
        exclusive: true
        onEvents:
          - eventRefs:
              - DevelopmentCompleteEvent
            actions:
              - name: LogDevelopmentComplete
                functionRef:
                  refName: printMessage
                  arguments:
                    message: "Development completed, transitioning to Testing"
            eventDataFilter:
              toStateData: ".latestAudit"
        stateDataFilter:
          input: |
            . + {
              latestAudit: null,
              reviewHistory: ((.reviewHistory // []) + [{stage: "development", action: "started", timestamp: (now | tostring), user: "system", commitSha: (.auditTrailSha // "")}])
            }
          output: |
            . + {
              reviewHistory: ((.reviewHistory // []) + (if .latestAudit then [.latestAudit] else [] end)),
              auditTrailSha: (.latestAudit.commitSha // .auditTrailSha),
              rejection: (.rejection + { isRejected: false, reasons: [(.rejection.reasons // [])[] | . + {resolved: true}] }),
              hasDrift: false
            }
        transition:
          nextState: JiraSyncDev
      - name: JiraSyncDev
        type: operation
        actions:
          - name: SyncJiraDev
            functionRef:
              refName: syncjiratasks
              arguments:
                businessKey: .projectId
                deploymentMode: .deploymentMode
                status: "DevelopmentComplete"
            actionDataFilter:
              toStateData: .jiraSyncResponse
        stateDataFilter:
          output: ". | del(.jiraSyncResponse)"
        transition:
          nextState: Testing
      - name: Testing
        type: event
        exclusive: true
        onEvents:
          - eventRefs:
              - TestingCompleteEvent
            actions:
              - name: LogTestingComplete
                functionRef:
                  refName: printMessage
                  arguments:
                    message: "Testing completed, transitioning to Published"
            eventDataFilter:
              toStateData: ".latestAudit"
        stateDataFilter:
          input: |
            . + {
              latestAudit: null,
              reviewHistory: ((.reviewHistory // []) + [{stage: "testing", action: "started", timestamp: (now | tostring), user: "system", commitSha: (.auditTrailSha // "")}])
            }
          output: |
            . + {
              reviewHistory: ((.reviewHistory // []) + (if .latestAudit then [.latestAudit] else [] end)),
              auditTrailSha: (.latestAudit.commitSha // .auditTrailSha)
            }
        transition:
          nextState: JiraSyncFinal
      - name: JiraSyncFinal
        type: operation
        actions:
          - name: SyncJiraFinal
            functionRef:
              refName: syncjiratasks
              arguments:
                businessKey: .projectId
                deploymentMode: .deploymentMode
                status: "TestingComplete"
            actionDataFilter:
              toStateData: .jiraSyncResponse
        stateDataFilter:
          output: ". | del(.jiraSyncResponse)"
        transition:
          nextState: Published
      - name: Published
        type: inject
        data:
          stage: published
          completedAt: "${ now() }"
        stateDataFilter:
          output: |
            . + {
              reviewHistory: ((.reviewHistory // []) + [{stage: "published", action: "started", timestamp: (now | tostring), user: "system", commitSha: (.auditTrailSha // "")}, {stage: "published", action: "complete", timestamp: (now | tostring), user: "system", commitSha: (.auditTrailSha // "")}])
            }
        end:
          terminate: true
  persistence:
    dbMigrationStrategy: service
    postgresql:
      secretRef:
        name: sonataflow-postgresql-svcbind
        passwordKey: password
        userKey: username
      serviceRef:
        databaseName: "{{ sonataflow_db_name }}"
        databaseSchema: publishing-house-workflow
        name: sonataflow-postgresql
        port: 5432
  podTemplate:
    container:
      env:
        - name: QUARKUS_FLYWAY_MIGRATE_AT_START
          value: "true"
        - name: QUARKUS_FLYWAY_BASELINE_ON_MIGRATE
          value: "true"
        - name: KIE_FLYWAY_ENABLED
          value: "true"
        - name: QUARKUS_REST_CLIENT_READ_TIMEOUT
          value: "70000"
  resources:
    configMaps:
      - configMap:
          name: workflow-input-schema
      - configMap:
          name: central-api-spec
        workflowPath: specs
